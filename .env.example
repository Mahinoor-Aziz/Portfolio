OPENAI_API_KEY=your_secret_key_here
OPENAI_MODEL=gpt-4.1-mini
PORT=5000
# Origins allowed to call the API (use your real domain in production)
ALLOWED_ORIGIN=http://localhost:5000
# Your private email, revealed only on request through the API (never put it in HTML or knowledge.json)
CONTACT_EMAIL=you@example.com
# Generate with: npm run hash-password -- "a-long-password"
ADMIN_PASSWORD_HASH=
# Set to 1 when deployed behind a proxy or host such as Render, Railway or Vercel
TRUST_PROXY=
# Your public site address (used for sitemap and share previews), e.g. https://yourname.com
SITE_URL=http://localhost:5000
# Set to production when deployed
NODE_ENV=development
